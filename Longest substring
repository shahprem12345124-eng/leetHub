/**
 * @param {string} s
 * @return {number}
 */
var lengthOfLongestSubstring = function(s) {
    let maxlength = 0;
    let map = new Map();
    let string = "";
    let start = 0;


    for(let end=0;end<s.length;end++){
        let char = s[end];

        if(map.has(char) && map.get(char)>=start){
            start = map.get(char) + 1;
        }

        map.set(char,end);

        if(end - start + 1 > maxlength){
            maxlength = end - start + 1;
            string = s.slice(start,end+1);
        }
    }
    return maxlength;
};
